# .env.example for F1 2026 Scorito Helper

# Database connection string (Postgres, Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/scorito_f1_2026

# OpenF1 API base URL
OPENF1_BASE=https://api.openf1.org/v1

# App name (public-facing)
PUBLIC_APP_NAME=f1-2026

# Vercel/Deployment (Frontend)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# Railway/Deployment (API)
RAILWAY_TOKEN=

PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
